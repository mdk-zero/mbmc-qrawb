# Database (XAMPP defaults). Same names and meanings as mbmc-qras.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=qr_attendance

# Port the kiosk opens (http://localhost:3000)
PORT=3000

# Password for the first admin account, created on first start when no admin exists.
# Change it before using the admin pages.
ADMIN_PASSWORD=change-me

# Secret for signing admin session cookies: at least 32 random characters.
SESSION_SECRET=

# Time zone that decides "today" and stamps scans
APP_TIMEZONE=Asia/Manila

# Folder for employee photos, relative to the app folder
UPLOADS_DIR=uploads
